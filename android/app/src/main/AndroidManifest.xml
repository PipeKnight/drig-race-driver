<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan 1.1 is wgpu's primary Android backend; GLES stays possible. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Pad rumble and phone vibration (Rumble.java); a normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <!-- Copies bundled game data on the first start, then starts the game
             (LauncherActivity.java, docs/ANDROID.md). -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <meta-data
                android:name="android.app.lib_name"
                android:value="grid_android" />
        </activity>
        <!-- Restarts the game process (event menu, docs/EVENT_MENU.md); its own
             process waits for the game's to end. -->
        <activity
            android:name=".RelaunchActivity"
            android:exported="false"
            android:process=":relaunch"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Start-up errors and panics; its own process outlives the game's. -->
        <activity
            android:name=".ErrorActivity"
            android:exported="false"
            android:process=":error"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>

</manifest>
